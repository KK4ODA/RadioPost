{
  "name": "ICS-204 Assignment List",
  "note": "After FEMA's ICS 204 Assignment List (NIMS ICS Forms Booklet, FEMA 502-2), a United States government form in the public domain. Dates and times are UTC; signatures are left to the paper form.",
  "fields": [
    {"n": 1, "label": "Incident name", "type": "line", "max": 80},
    {"n": 2, "label": "Operational period from", "type": "datetime"},
    {"n": 3, "label": "Operational period to", "type": "datetime"},
    {"n": 4, "label": "Branch", "type": "line", "max": 40},
    {"n": 5, "label": "Division", "type": "line", "max": 40},
    {"n": 6, "label": "Group", "type": "line", "max": 40},
    {"n": 7, "label": "Staging area", "type": "line", "max": 40},
    {"n": 8, "label": "Operations personnel", "type": "rows", "columns": [{"n": 1, "label": "Position", "type": "choice", "choices": ["Operations Section Chief", "Branch Director", "Division/Group Supervisor"], "required": true}, {"n": 2, "label": "Name", "type": "line", "max": 80}, {"n": 3, "label": "Contact number(s)", "type": "line", "max": 80}], "max": 3},
    {"n": 9, "label": "Resources assigned", "type": "rows", "columns": [{"n": 1, "label": "Resource identifier", "type": "line", "max": 40, "required": true}, {"n": 2, "label": "Leader", "type": "line", "max": 80}, {"n": 3, "label": "Number of persons", "type": "number"}, {"n": 4, "label": "Contact (phone, pager, radio frequency)", "type": "line", "max": 80}, {"n": 5, "label": "Reporting location, special equipment and supplies, remarks, notes", "type": "line", "max": 200}], "max": 20},
    {"n": 10, "label": "Work assignments", "type": "text"},
    {"n": 11, "label": "Special instructions", "type": "text"},
    {"n": 12, "label": "Communications", "type": "rows", "columns": [{"n": 1, "label": "Name/function", "type": "line", "max": 80, "required": true}, {"n": 2, "label": "Primary contact: cell, pager or radio (frequency/system/channel)", "type": "line", "max": 80}], "max": 8},
    {"n": 13, "label": "Prepared by (name and position/title)", "type": "line", "max": 80},
    {"n": 14, "label": "Date prepared", "type": "date", "bound": "date"},
    {"n": 15, "label": "Time prepared", "type": "time", "bound": "time"}
  ]
}
