          "text": "no `data`"
        }
      ]
    },
    {
      "what": "a broadcast's ref that is an object",
      "line": "{\"op\": \"broadcast\", \"id\": 36, \"data\": \"AQ==\", \"ref\": {}}",
      "answers": [
        {
          "op": "error",
          "id": 36,
          "code": "malformed",
          "text": "`ref` is not of its type"
        }
      ]
    },
    {
      "what": "a tone without its seconds",
      "line": "{\"op\": \"tone\", \"id\": 37}",
      "answers": [
        {
          "op": "error",
          "id": 37,
          "code": "malformed",
          "text": "no `seconds`"
        }
      ]
    },
    {
      "what": "a tone longer than ten seconds",
      "line": "{\"op\": \"tone\", \"id\": 38, \"seconds\": 11}",
      "answers": [
        {
          "op": "error",
          "id": 38,
          "code": "malformed",
          "text": "`seconds` is not of its type"
        }
      ]
    },
    {
      "what": "an id of 1.0, written with a fraction",
      "line": "{\"op\": \"status\", \"id\": 1.0}",
      "answers": [
        {
          "op": "error",
          "code": "malformed",
          "text": "`id` is neither a string nor an integer"
        }
      ]
    },
    {
      "what": "an id of 1e2, written with an exponent",
      "line": "{\"op\": \"status\", \"id\": 1e2}",
      "answers": [
        {
          "op": "error",
          "code": "malformed",
          "text": "`id` is neither a string nor an integer"
        }
      ]
    },
    {
      "what": "an id of 2^53, past an integer's range",
      "line": "{\"op\": \"status\", \"id\": 9007199254740992}",
      "answers": [
        {
          "op": "error",
          "code": "malformed",
          "text": "`id` is neither a string nor an integer"
        }
      ]
    },
    {
      "what": "an id of -(2^53-1), the least integer",
      "line": "{\"op\": \"status\", \"id\": -9007199254740991}",
      "answers": [
        {
          "op": "status",
          "id": -9007199254740991,
          "listening": false,
          "callsigns": [
            "KK4ODA"
          ],
          "busy": false,
          "links": []
        }
      ]
