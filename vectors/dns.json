{
  "radiopost_vectors": "`_radiopost` TXT records, which post offices a gateway trusts, and which a post office knows",
  "format": 1,
  "specs": {
    "RP-1": "§7.1, §7.3, §7.5"
  },
  "made_by": "tools/vectors/make.py",
  "rule": "Parsing `txt` gives `result`: the record's tags, or null when it must be ignored. A gateway that learned post offices as `found` says (`dns`, or `list:` and the post office whose list named it) trusts a case's `domain`, given its operator's `blocked` and `only`, when `expect` is true (RP-1 §7.3). A post office with `office`'s own domains, the domains its operators `accepted` and `blocked`, and the DNS `zone` (each domain's `_radiopost` TXT records) makes of a domain it meets `expect`: `known`, `seen` (kept for its operators), or `ignored` (RP-1 §7.5). `met` says where it met it; it does not change the answer.",
  "records": [
    {
      "what": "an API record",
      "txt": "v=RP1; t=api; url=https://po.radiopost.org/rp/v1",
      "result": {
        "v": "RP1",
        "t": "api",
        "url": "https://po.radiopost.org/rp/v1"
      }
    },
    {
      "what": "a key record",
      "txt": "v=RP1; t=key; kid=fbbd5f5c; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
      "result": {
        "v": "RP1",
        "t": "key",
        "kid": "fbbd5f5c",
        "p": "dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY="
      }
    },
    {
      "what": "no spaces",
      "txt": "v=RP1;t=key;kid=fbbd5f5c;p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
      "result": {
        "v": "RP1",
        "t": "key",
        "kid": "fbbd5f5c",
        "p": "dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY="
      }
    },
    {
      "what": "spaces around everything, a `;` at the end",
      "txt": "  v=RP1 ; t=key ; kid=fbbd5f5c ; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY= ;",
      "result": {
        "v": "RP1",
        "t": "key",
        "kid": "fbbd5f5c",
        "p": "dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY="
      }
    },
    {
      "what": "an unknown tag",
      "txt": "v=RP1; t=key; kid=fbbd5f5c; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=; note=rotated 2026",
      "result": {
        "v": "RP1",
        "t": "key",
        "kid": "fbbd5f5c",
        "p": "dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
        "note": "rotated 2026"
      }
    },
    {
      "what": "another version",
      "txt": "v=RP2; t=key; kid=fbbd5f5c; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
      "result": null
    },
    {
      "what": "a `kid` that is not the key's",
      "txt": "v=RP1; t=key; kid=00000000; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
      "result": null
    },
    {
      "what": "a key of 31 bytes",
      "txt": "v=RP1; t=key; kid=fbbd5f5c; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XA==",
      "result": null
    },
    {
      "what": "a tag twice",
      "txt": "v=RP1; t=key; kid=fbbd5f5c; kid=fbbd5f5c; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
      "result": null
    },
    {
      "what": "an API URL that is not https",
      "txt": "v=RP1; t=api; url=http://po.radiopost.org/rp/v1",
      "result": null
    },
    {
      "what": "no `t`",
      "txt": "v=RP1; kid=fbbd5f5c; p=dmDCk1mTrS70nNg/yQuSYaxq1/AR6moPzpckQDM+XAY=",
      "result": null
    },
    {
      "what": "not RadioPost's: an SPF record",
      "txt": "v=spf1 mx -all",
      "result": null
    }
  ],
  "found": {
