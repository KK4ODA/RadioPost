  "every_type": {
    "rule": "`template` becomes exactly `canonical_hex` (RP-2 §8.1) and has the fingerprint `fingerprint_hex`. Each of `messages` shows as `text` with the template and as `text_without_template` without it (§8.4). Each of `values_shown` is the value of the template's field `field`, written `shown` (§8.4; a `rows` value's lines joined by LF). Each check's `values` give `expect`: `fills the template`, or why not (§8.2). Each of `templates` keeps §8.1's rules (`keeps the rules`) or is not a template, `expect` saying which rule it breaks. In JSON a map's keys are its numbers written as text.",
    "template": {
      "name": "Every type (test)",
      "note": "RP-2 §8's test template, in vectors/forms.json only: every type of field.",
      "fields": [
        {
          "n": 1,
          "label": "Incident name",
          "type": "line",
          "max": 40
        },
        {
          "n": 2,
          "label": "Where and when",
          "type": "heading"
        },
        {
          "n": 3,
          "label": "Location",
          "type": "position",
          "required": true
        },
        {
          "n": 4,
          "label": "Observed",
          "type": "datetime"
        },
        {
          "n": 5,
          "label": "Damage",
          "type": "heading"
        },
        {
          "n": 6,
          "label": "Damage seen",
          "type": "multi",
          "choices": [
            "Roof",
            "Windows",
            "Flooding",
            "Power lines down"
          ]
        },
        {
          "n": 7,
          "label": "Rainfall",
          "type": "number",
          "scale": 2,
          "unit": "in"
        },
        {
          "n": 8,
          "label": "Wind gust",
          "type": "number",
          "unit": "mph"
        },
        {
          "n": 9,
          "label": "Water depth, feet",
          "type": "number",
          "scale": 1
        },
        {
          "n": 10,
          "label": "Injuries",
          "type": "check"
        },
        {
          "n": 11,
          "label": "Approval",
          "type": "heading"
        },
        {
          "n": 12,
          "label": "Approved by",
          "type": "line",
          "max": 40
        },
        {
          "n": 13,
          "label": "Log",
          "type": "heading"
        },
        {
          "n": 14,
          "label": "Communications log",
          "type": "rows",
          "max": 5,
          "columns": [
            {
              "n": 1,
              "label": "Time",
              "type": "datetime",
              "required": true
            },
            {
              "n": 2,
              "label": "From",
              "type": "line",
              "required": true,
              "max": 10
            },
            {
              "n": 3,
              "label": "To",
              "type": "line",
              "max": 10
            },
            {
              "n": 4,
              "label": "Message",
              "type": "line",
              "max": 80
            },
            {
              "n": 5,
              "label": "Precedence",
              "type": "choice",
              "choices": [
                "Routine",
                "Priority",
                "Emergency"
              ]
            }
          ]
        },
        {
          "n": 15,
          "label": "Remarks",
          "type": "text"
        }
      ]
    },
