{
  "radiopost_vectors": "Forms: templates, fingerprints, a form's text and its values checked",
  "format": 1,
  "specs": {
    "RP-2": "§8"
  },
  "made_by": "tools/vectors/make.py",
  "rule": "Each template file becomes exactly `canonical_hex` (RP-2 §8.1) and has the fingerprint `fingerprint_hex`. The named message (messages.json) shows as `text` with its template and as `text_without_template` without it (§8.4). Each check's `values`, against ICS-213, give `expect`: `fills the template`, or why not (§8.2).",
  "templates": [
    {
      "file": "forms/ics-213.json",
      "diagnostic": "{1: \"ICS-213 General Message\", 2: [{1: 1, 2: \"Incident name\", 3: 0, 7: 80}, {1: 2, 2: \"To (name and position)\", 3: 0, 4: true, 7: 80}, {1: 3, 2: \"From (name and position)\", 3: 0, 4: true, 7: 80}, {1: 4, 2: \"Subject\", 3: 0, 6: 1}, {1: 5, 2: \"Date\", 3: 2, 6: 2}, {1: 6, 2: \"Time\", 3: 3, 6: 3}, {1: 7, 2: \"Message\", 3: 1, 4: true}, {1: 8, 2: \"Approved by (name and position)\", 3: 0, 7: 80}, {1: 9, 2: \"Reply\", 3: 1}, {1: 10, 2: \"Replied by (name and position)\", 3: 0, 7: 80}, {1: 11, 2: \"Reply date and time\", 3: 0, 7: 40}], 3: \"After FEMA's ICS 213 General Message, a United States government form in the public domain.\"}",
      "canonical_hex": "",
      "fingerprint_hex": "25393c52580e7a3c"
    }
  ],
  "shown": [
    {
      "message": "shelter3-213",
      "template_file": "forms/ics-213.json",
      "text": "ICS-213 General Message\n\nIncident name: Storm response, Atlanta\nTo (name and position): Duty officer, county EOC\nFrom (name and position): J. Park, Shelter 3 manager\nSubject: Cots and water for tonight\nDate: 2026-11-09\nTime: 14:10 UTC\nMessage:\n140 people tonight, 30 more expected by 20:00.\nNeed 40 cots and 300 litres of drinking water.\nGenerator fuel for 12 hours.\nApproved by (name and position): J. Park, Shelter 3 manager\n",
      "text_without_template": "Form 25393c52580e7a3c\n\nField 1: Storm response, Atlanta\nField 2: Duty officer, county EOC\nField 3: J. Park, Shelter 3 manager\nField 7:\n140 people tonight, 30 more expected by 20:00.\nNeed 40 cots and 300 litres of drinking water.\nGenerator fuel for 12 hours.\nField 8: J. Park, Shelter 3 manager\n"
    }
  ],
